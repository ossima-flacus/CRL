# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crl_db
DB_USER=root
DB_PASSWORD=

# Application
APP_NAME=CRL
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/CRL

# Session
SESSION_NAME=CRL_SESSION
SESSION_LIFETIME=3600

# Security
JWT_SECRET=your-secret-key-here
CORS_ALLOWED_ORIGINS=http://localhost

# Email (optional)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
